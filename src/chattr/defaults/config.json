{
  "header": {
    "description": "Chattr Global Configuration - Application-wide settings",
    "version": "2.0.0",
    "last_updated": "2025-11-11",
    "schema_notes": "Global settings only - service-specific configs are in Services/ folder"
  },
  "global": {
    "general": {
      "output_directory": "{CHATTR_ROOT}/Output",
      "temp_directory": "{CHATTR_ROOT}/temp",
      "log_level": "INFO"
    },
    "owner": {
      "name": "",
      "identifiers": []
    },
    "contacts": {
      "vcf_file_path": "",
      "phone_region": "US",
      "enable_contact_resolution": true,
      "normalize_phone_numbers": true
    },
    "performance": {
      "max_workers": 4,
      "batch_size": 1000,
      "enable_parallel_processing": true,
      "memory_limit_mb": null
    },
    "ai_translation": {
      "enabled": false,
      "endpoint": "http://localhost:11434/v1",
      "model": "",
      "target_language": "English",
      "api_key_env_var": "CHATTR_TRANSLATION_API_KEY",
      "allow_remote": false,
      "timeout_seconds": 60
    },
    "database": {
      "unified_schema": {
        "enabled": false,
        "file": "{CHATTR_ROOT}/Database/chattr.sqlite",
        "version": "1.0"
      },
      "per_service_exports": {
        "enabled": true,
        "format": "json",
        "separate_files": true
      }
    }
  }
}
